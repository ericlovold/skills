# Copy to .env. Never commit .env.

# Google Cloud project with "Places API (New)" enabled.
GOOGLE_PLACES_API_KEY=

# Apollo.io API key. Enrichment is off unless APOLLO_ENABLE_ENRICH=true.
APOLLO_API_KEY=
APOLLO_ENABLE_ENRICH=false

# SQLite store and footprint list.
LEADPIPE_DB=data/leads.sqlite
FOOTPRINT_CSV=data/comcast_footprint_zips.csv

# Minneapolis CCS Permits. Run `python -m leadpipe probe mpls` and set the
# field overrides to match the live layer.
MPLS_PERMITS_URL=https://services.arcgis.com/afSMGVsC7QlRK1kZ/arcgis/rest/services/CCS_Permits/FeatureServer/0
MPLS_FIELD_APPLICANT=ApplicantName
MPLS_FIELD_ADDRESS=Display
MPLS_FIELD_PERMIT_TYPE=PermitType
MPLS_FIELD_WORK_TYPE=WorkType
MPLS_FIELD_DESCRIPTION=Comments
MPLS_FIELD_DATE=IssueDate
MPLS_FIELD_VALUE=Value

# Saint Paul building permits. Leave blank to skip until the FeatureServer
# URL is confirmed from information.stpaul.gov ("View API Resources").
STPAUL_PERMITS_URL=
STPAUL_FIELD_APPLICANT=APPLICANT
STPAUL_FIELD_ADDRESS=ADDRESS
STPAUL_FIELD_PERMIT_TYPE=PERMIT_TYPE
STPAUL_FIELD_WORK_TYPE=WORK_TYPE
STPAUL_FIELD_DESCRIPTION=DESCRIPTION
STPAUL_FIELD_DATE=ISSUE_DATE
STPAUL_FIELD_VALUE=VALUATION

# How far back ingest looks on each run.
INGEST_DAYS=7
